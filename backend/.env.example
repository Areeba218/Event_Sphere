# Copy this file to .env and fill in your own values. Never commit .env.
PORT=5000
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER/eventsphere?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret
# One or more allowed frontend origins, comma separated
FRONTEND_URL=http://localhost:5173

# Email (verification, password reset, session reminders)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email_address
SMTP_PASS=your_email_app_password
# Development only: print emails to the console instead of sending (no SMTP needed)
# EMAIL_MODE=console

# Organizer sign-up control (production): disable self-service or require a code
# ALLOW_ORGANIZER_SIGNUP=false
# ORGANIZER_INVITE_CODE=choose_a_secret_code

# Operations (optional)
# REMINDER_MINUTES=30        minutes before a session to send reminders
# BACKUP_EVERY_HOURS=24      enable automatic JSON backups (kept in backend/backups)
# BACKUP_KEEP=14
# API_RATE_LIMIT=600         requests per minute per IP
# AUTH_RATE_LIMIT=60         auth requests per 15 minutes per IP
# TRUST_PROXY=1              set when running behind a reverse proxy / load balancer

# Tests: a throw-away MongoDB database (it is wiped!). If unset, mongodb-memory-server is used.
# MONGO_URI_TEST=mongodb://127.0.0.1:27017/eventsphere_test
